DATABASE_URL=postgresql://postgres:password@api.duckq1linux.id.vn:8528/MedEdu-2
MARKER_URL=http://localhost:8001/marker
BOOK_ENTITIES_INDEX_PATH=./cache
MARKDOWN_PATH=./cache/markdown_indexes
QUIZZ_PATH=./cache/quizz_indexes
ADMIN_ID=admin-uuid-placeholder
N8N_WEBHOOK_URL=http://your-n8n-host/webhook/your-webhook-id

# AI Provider Configuration
# Options: "n8n" (default) or "bedrock"
AI_PROVIDER=n8n

# Amazon Bedrock Configuration (required when AI_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.7
BEDROCK_TOP_P=0.9
BEDROCK_CONTEXT_CHAR_LIMIT=50000

# Notebook runtime selector
AI_RUNTIME=bedrock_provider

# AgentCore runtime configuration (required when AI_RUNTIME=agentcore)
AGENTCORE_CHAT_AGENT_ID=
AGENTCORE_CHAT_AGENT_ALIAS_ID=TSTALIASID
AGENTCORE_KNOWLEDGE_BASE_ID=
AGENTCORE_QUIZ_AGENT_ID=
AGENTCORE_QUIZ_AGENT_ALIAS_ID=TSTALIASID
AGENTCORE_FLASHCARD_AGENT_ID=
AGENTCORE_FLASHCARD_AGENT_ALIAS_ID=TSTALIASID
